# Copy to .env.local for local development. Never commit real values.

# Neon PostgreSQL (Prisma + @prisma/adapter-pg). Required at runtime.
DATABASE_URL=

# NextAuth v5 signing secret. Required in production. AUTH_SECRET is preferred;
# NEXTAUTH_SECRET is accepted as a legacy alias.
AUTH_SECRET=
NEXTAUTH_SECRET=

# Public app origin used for password-reset links and study-key emails.
# NEXTAUTH_URL is required for password-reset URLs.
# AUTH_URL is an optional fallback for study-key emails only.
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=

# Stampley generation (server-only). Required for /api/stampley/generate.
OPENAI_API_KEY=

# Resend email. Required to send password-reset and study-key messages.
RESEND_API_KEY=
# Verified sender, e.g. AIDES-T2D <hello@your-verified-domain>
EMAIL_FROM=
